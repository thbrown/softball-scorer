/**
 * This is the server side configuration template. To use a custom configuration, please copy this file and rename it to 'config.json'
 * If there is no config.js file present during the build, the build process will copy this one for you.
 **/
{
  "app": {
    "port": null,
    "optimizationSweeperPeriod": null,
    "optimizationLockTTL": null
  },
  "database": {
    "mode": "FileSystem",
    "host": null,
    "port": null,
    "username": null,
    "password": null,
    "database": null
  },
  "cache": {
    "host": null,
    "port": null,
    "password": null
  },
  // If you enable session caching, but don't set this, your sessions wont persist across app server restarts
  "session": {
    "secretkey": null
  },
  "recapcha": {
    "secretkey": null
  },
  "logging": {
    "toFile": false,
    "colorOff": false,
    // "json" emits one structured JSON line per entry (recommended for production — Cloud
    // Logging's Ops Agent parses these into queryable fields). "text" keeps the legacy
    // tab-separated human-readable format. Omit to auto-select based on whether stdout is
    // a TTY (dev terminal → text, systemd/screen-redirected/docker → json).
    "format": null
  },
  "email": {
    "apiKey": null,
    "domain": null,
    "restrictEmailsToDomain": null
  },
  "optimization": {
    "port": null
  },
  "optimizationCompute": {
    "mode": "local",
    "params": null
  },
  "youtube": {
    "apikey": null
  },
  "optimizerGallery": {
    "definitionsUrl": null
  }
}
