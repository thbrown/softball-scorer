{
  "name": "client",
  "version": "1.0.0",
  "main": "src/index.html",
  "license": "MIT",
  "scripts": {
    "start": "vite serve src --config ./vite.config.ts",
    "start:dev": "yarn start",
    "watch:css": "node scripts/watch-css-vars.js",
    "generate:css-vars": "tsx scripts/generate-css-vars.ts",
    "prebuild": "yarn generate:css-vars",
    "build": "yarn typecheck && yarn clean && vite build src --config ./vite.config.ts",
    "build:css": "tsx scripts/build-css",
    "clean": "rm -rf ../build",
    "typecheck": "tsc",
    "lint:check": "eslint --ext .ts,.tsx,.js,.jsx src",
    "lint:fix": "eslint --ext .ts,.tsx,.js,.jsx --fix src",
    "test": "vitest --coverage run",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "file-saver": "^2.0.5",
    "happy-dom": "^20.9.0",
    "idb": "^8.0.3",
    "jsonpointer": "^5.0.1",
    "lz-string": "^1.5.0",
    "postcss": "^8.5.10",
    "postcss-import": "^16.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-draggable": "^4.4.3",
    "react-select": "^5.10.2",
    "rollup-plugin-copy": "^3.5.0",
    "shared-lib": "1.0.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.16",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4",
    "vitest-github-actions-reporter": "^0.11.1"
  }
}
